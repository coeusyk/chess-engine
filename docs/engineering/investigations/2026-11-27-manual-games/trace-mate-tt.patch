index 583e052..e33e9c0 100644
--- a/engine-core/src/main/java/coeusyk/game/chess/core/models/Board.java
+++ b/engine-core/src/main/java/coeusyk/game/chess/core/models/Board.java
@@ -1189,0 +1190,18 @@ public class Board {
+    public String replayHistory() {
+        StringBuilder history = new StringBuilder(toFen()).append(" history=");
+        int current = zobristSP - 1;
+        int first = Math.max(repetitionFloor, current - Math.max(0, halfmoveClock));
+        for (int i = first; i <= current; i++) {
+            if (i == searchRootIndex) history.append('|');
+            history.append(String.format("%016x,", zobristStack[i]));
+        }
+        history.append(" line=");
+        for (int i = 0; i < unmakeSP; i++) {
+            int move = unmakePool[i].packedMove;
+            int from = Move.from(move), to = Move.to(move);
+            history.append((char) ('a' + from % 8)).append(8 - from / 8);
+            history.append((char) ('a' + to % 8)).append(8 - to / 8).append(',');
+        }
+        return history.toString();
+    }
+
