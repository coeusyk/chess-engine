#!/usr/bin/env bash
# Pre-commit hook: best-effort local Graphify refresh, never gated into the commit.
#
# graphify-out/ is a generated artifact and is deliberately gitignored (.gitignore's own
# "### Graphify ###" section) -- it has never been tracked in this repository's history. This
# hook therefore does NOT stage graphify-out/: it only refreshes it on disk as a courtesy for
# whoever's working directory wants an up-to-date local graph, purely optional and with zero
# effect on what gets committed.
#
# An earlier version of this hook staged the graph output after refreshing it, on the
# mistaken premise that graphify-out/ was meant to be committed alongside the code change that
# made it stale. Since graphify-out/ is gitignored, staging an ignored path without a force
# flag fails, and under `set -e` that failure aborted the whole hook -- silently breaking this
# file's own "never blocks the commit" guarantee for every commit that reached that line.
# Fixed by removing the staging attempt entirely; see .githooks/test_pre_commit.sh for the
# regression check.
#
# Enabled per clone with one command (not automatic -- this repo has no npm-based hook
# installer like Husky):
#   git config core.hooksPath .githooks
set -euo pipefail

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || true)
[ -n "$GIT_DIR" ] || exit 0
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

command -v graphify >/dev/null 2>&1 || exit 0

# Only bother if this commit actually touches something other than graphify-out/ itself --
# avoids a pointless rebuild on a commit that wouldn't change what the graph describes.
STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0
NON_GRAPH=$(printf '%s\n' "$STAGED" | grep -v '^graphify-out/' || true)
[ -z "$NON_GRAPH" ] && exit 0

# Pins networkx louvain's iteration order (see graphify's own removed post-commit hook) so
# the same source tree produces the same communities run to run.
export PYTHONHASHSEED=0

# Best-effort, local-only refresh. graphify-out/ is gitignored and is never staged here --
# `||` makes this a pure courtesy: a slow, failed, or unavailable refresh must never affect
# the commit that triggered it.
graphify update . >/tmp/graphify-precommit.log 2>&1 || \
  echo "[graphify pre-commit] update failed, see /tmp/graphify-precommit.log -- local graph not refreshed (commit unaffected)" >&2

exit 0
